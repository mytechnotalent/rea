# OpenRouter API Key for the autonomous AI analyst loop
OPENROUTER_API_KEY="your-api-key-here"

# Primary model (defaults to deepseek/deepseek-v4.1-flash). If the primary model
# is unavailable, the analyst fails over to openrouter/free automatically.
OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"

# Optional tuning (all values shown are the defaults)
# REA_FALLBACK_MODELS="openrouter/free"  # comma-separated fallback model chain
# REA_MAX_TOKENS="16000"                 # per-turn output cap (lower saves credits)
# REA_AGENT_BUDGET_SECS="420"            # wall-clock budget for the analyst loop
# REA_VERIFY="1"                         # enable adversarial reviewers + adjudicator
# REA_REVIEWERS="2"                      # number of adversarial reviewers
# REA_VERIFY_ROUNDS="3"                  # proof rounds before unverified lines are removed
# REA_LOAD_BASE="0x4000000"              # force a raw-image load base for the provider
