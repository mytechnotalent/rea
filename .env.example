# REA AI analyst configuration.
#
# The one-shot analyst works with either OpenRouter or OpenCode Go. Select a
# provider below; everything else is optional tuning.

# --- OpenRouter (default) ---
OPENROUTER_API_KEY="your-openrouter-api-key"
# OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"   # default

# --- OpenCode Go (higher quality; optional) ---
# Subscribe at https://opencode.ai/console and copy your API key.
# REA_PROVIDER="opencode-go"                    # uses https://opencode.ai/inference/go/v1/chat/completions
# REA_API_KEY="your-opencode-go-api-key"
# OPENROUTER_MODEL="deepseek-v4.1-flash"        # default model for OpenCode Go

# --- Advanced overrides ---
# REA_API_KEY="..."                      # key for any OpenAI-compatible provider
# REA_API_BASE="https://host/v1/chat/completions"  # any OpenAI-compatible endpoint
# REA_MODEL="..."                        # model id (overrides OPENROUTER_MODEL)
# REA_FALLBACK_MODELS="openrouter/free"  # comma-separated fallback chain
# REA_MAX_TOKENS="16000"                 # per-turn output cap (lower saves credits)
# REA_AGENT_BUDGET_SECS="420"            # wall-clock budget for the analyst loop
# REA_VERIFY="1"                         # enable adversarial reviewers + adjudicator
# REA_REVIEWERS="2"                      # number of adversarial reviewers
# REA_VERIFY_ROUNDS="3"                  # proof rounds before unverified lines are removed
# REA_LOAD_BASE="0x4000000"              # force a raw-image load base for the provider
